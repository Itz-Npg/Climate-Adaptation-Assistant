# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/climate-adaptation?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign JWT session tokens. REQUIRED: at least 32 random characters.
# The server refuses to start with a short or placeholder value.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# Session lifetime in days
JWT_EXPIRES_DAYS=7

# Comma-separated emails promoted to the admin role on sign-in.
# Leave empty in production unless you really want those accounts as admins.
# For the student demo: ADMIN_EMAILS=demo@example.com
ADMIN_EMAILS=

# Frontend origin(s) allowed by CORS and the CSRF origin check.
# Use a comma-separated list in production, e.g. https://app.example.com,https://www.example.com
CLIENT_URL=http://localhost:5173

# Optional: real weather data provider used by the risk checker. Without a key
# the app uses clearly labelled illustrative data. See README.md "External climate API".
OPENWEATHER_API_KEY=

# Maps and the Climate Map page (/api/geo/*) need NO key: they use the free
# Open-Meteo geocoding/forecast APIs and free Esri, CARTO and OpenTopoMap tiles.
